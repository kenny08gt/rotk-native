+// fast_fcmp from recomp/chassis/fast_cpu.h: ordered operands set FPCC and the
+// CR field inline in any FPSCR mode; NaNs go to the helper for the exception
+// bits.
+void FunctionEmitter::emitExactCompareInline(DolIRExactFloat op, u32 a, u32 b,
+                                             u32 crfd) {
+  Value *left = stateValue(static_cast<DolIRStateSlot>(DOLIR_STATE_FPR0 + a));
+  Value *right = stateValue(static_cast<DolIRStateSlot>(DOLIR_STATE_FPR0 + b));
+  Value *fpscr = stateValue(DOLIR_STATE_FPSCR);
+  Value *ordered = builder_.CreateFCmpORD(left, right, "fcmp.ordered");
+  Value *compare = builder_.CreateSelect(
+      builder_.CreateFCmpOLT(left, right), builder_.getInt32(8),
+      builder_.CreateSelect(builder_.CreateFCmpOGT(left, right),
+                            builder_.getInt32(4), builder_.getInt32(2)),
+      "fcmp.field");
+  auto crSlot = static_cast<DolIRStateSlot>(DOLIR_STATE_CR0 + crfd);
+  emitFastOrExactHelper(
+      ordered,
+      [&] {
+        Value *kept =
+            builder_.CreateAnd(fpscr, builder_.getInt32(~(0xFu << 12)));
+        builder_.CreateStore(
+            builder_.CreateOr(kept, builder_.CreateShl(compare, 12)),
+            state_[DOLIR_STATE_FPSCR]);
+        builder_.CreateStore(compare, state_[crSlot]);
+      },
+      op, 0, a, b, 0, crfd);
+  known_state_[crSlot] = nullptr;
 }
 
