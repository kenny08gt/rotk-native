+static Value *constrainedBinary(IRBuilder<> &builder, Intrinsic::ID id,
+                                Value *left, Value *right) {
+  return builder.CreateConstrainedFPBinOp(id, left, right, nullptr, "fp.math",
+                                          nullptr, RoundingMode::Dynamic,
+                                          fp::ebIgnore);
+}
+
+static Value *constrainedFMA(IRBuilder<> &builder, Module &module, Value *x,
+                             Value *y, Value *z) {
+  Function *fma = Intrinsic::getDeclaration(
+      &module, Intrinsic::experimental_constrained_fma, {x->getType()});
+  return builder.CreateConstrainedFPCall(fma, {x, y, z}, "fp.fma",
+                                         RoundingMode::Dynamic, fp::ebIgnore);
+}
