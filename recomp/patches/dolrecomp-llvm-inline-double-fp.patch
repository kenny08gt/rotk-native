+// FAST_DOUBLE_OP and fast_fma (single=false) from recomp/chassis/fast_cpu.h:
+// in the default FPSCR mode the double result is computed inline and kept
+// when the library would store it unchanged (normal or zero for the binary
+// ops, finite for the fused ones). Only FPR[d] is written; PS1[d] keeps its
+// value, as in the library.
+void FunctionEmitter::emitExactDoubleInline(DolIRExactFloat op, u32 d, u32 a,
+                                            u32 b, u32 c, u32 crfd) {
+  Type *f64 = Type::getDoubleTy(context_);
+  Type *i64 = Type::getInt64Ty(context_);
+  auto fpr = [this](u32 reg) {
+    return stateValue(static_cast<DolIRStateSlot>(DOLIR_STATE_FPR0 + reg));
+  };
+  Value *fpscr = stateValue(DOLIR_STATE_FPSCR);
+  Value *ok = builder_.CreateICmpEQ(
+      builder_.CreateAnd(fpscr, builder_.getInt32(0xFBu)),
+      builder_.getInt32(0), "fpscr.fast");
+  Value *result = nullptr;
+  if (op >= DOLIR_EXACT_FMADD && op <= DOLIR_EXACT_FNMSUB) {
+    bool subtract = op == DOLIR_EXACT_FMSUB || op == DOLIR_EXACT_FNMSUB;
+    bool negative = op == DOLIR_EXACT_FNMADD || op == DOLIR_EXACT_FNMSUB;
+    Value *left = fpr(a);
+    Value *multiplier = fpr(c);
+    Value *addend = subtract ? builder_.CreateFNeg(fpr(b)) : fpr(b);
+    result = constrainedFMA(builder_, module_, left, multiplier, addend);
+    Value *exponent = builder_.CreateAnd(
+        builder_.CreateBitCast(result, i64),
+        builder_.getInt64(0x7FF0000000000000ull));
+    ok = builder_.CreateAnd(
+        ok, builder_.CreateICmpNE(exponent,
+                                  builder_.getInt64(0x7FF0000000000000ull)));
+    if (negative)
+      result = builder_.CreateFNeg(result);
+  } else {
+    Value *left = fpr(a);
+    Value *right = fpr(op == DOLIR_EXACT_FMUL ? c : b);
+    Intrinsic::ID id = op == DOLIR_EXACT_FADD
+                           ? Intrinsic::experimental_constrained_fadd
+                       : op == DOLIR_EXACT_FSUB
+                           ? Intrinsic::experimental_constrained_fsub
+                       : op == DOLIR_EXACT_FMUL
+                           ? Intrinsic::experimental_constrained_fmul
+                           : Intrinsic::experimental_constrained_fdiv;
+    result = constrainedBinary(builder_, id, left, right);
+    if (op == DOLIR_EXACT_FDIV)
+      ok = builder_.CreateAnd(
+          ok, builder_.CreateFCmpUNE(right, ConstantFP::get(f64, 0.0)));
+    // isnormal(r) || r == 0.0: exponent field in [1, 0x7FE], or +-0.
+    Value *bits = builder_.CreateBitCast(result, i64);
+    Value *exponent =
+        builder_.CreateAnd(bits, builder_.getInt64(0x7FF0000000000000ull));
+    Value *normal = builder_.CreateICmpULT(
+        builder_.CreateSub(exponent, builder_.getInt64(0x0010000000000000ull)),
+        builder_.getInt64(0x7FE0000000000000ull));
+    Value *zero = builder_.CreateICmpEQ(builder_.CreateShl(bits, 1),
+                                        builder_.getInt64(0));
+    ok = builder_.CreateAnd(ok, builder_.CreateOr(normal, zero));
+  }
+
+  DolIRStateSlot destination =
+      static_cast<DolIRStateSlot>(DOLIR_STATE_FPR0 + d);
+  emitFastOrExactHelper(
+      ok, [&] { builder_.CreateStore(result, state_[destination]); }, op, d,
+      a, b, c, crfd);
+  fp_rep_[d] = FPRepresentation::Raw;
+  fp_exact_single_[d] = false;
+  fp_denormal_safe_[d] = false;
+  fp_value_class_[d] = FPValueClass::Unknown;
+  known_state_[destination] = nullptr;
+}
