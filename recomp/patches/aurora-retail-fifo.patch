+// Retail FIFO arrays have no known size: scan this draw's indices and grow each indexed
+// array's upload size to cover the highest index used.
+static void size_retail_arrays(GXVtxFmt fmt, const u8* vtx, u32 vtxCount, u32 vtxSize) noexcept {
+  const auto& vtxFmt = g_gxState.vtxFmts[fmt];
+  u32 offsets[GX_VA_TEX7 + 1] = {};
+  u32 offset = 0;
+  bool any = false;
+  for (int i = GX_VA_PNMTXIDX; i <= GX_VA_TEX7; ++i) {
+    offsets[i] = offset;
+    const auto& attrFmt = vtxFmt.attrs[i];
+    const bool nbt3 = i == GX_VA_NRM && attrFmt.cnt == GX_NRM_NBT3;
+    switch (g_gxState.vtxDesc[i]) {
+    case GX_DIRECT:
+      offset += comp_type_size(static_cast<GXAttr>(i), attrFmt.type) *
+                comp_cnt_count(static_cast<GXAttr>(i), attrFmt.cnt);
+      break;
+    case GX_INDEX8:
+      offset += nbt3 ? 3 : 1;
+      any |= i >= GX_VA_POS && g_gxState.arrays[i].guestAvailable != 0;
+      break;
+    case GX_INDEX16:
+      offset += nbt3 ? 6 : 2;
+      any |= i >= GX_VA_POS && g_gxState.arrays[i].guestAvailable != 0;
+      break;
+    default:
+      break;
+    }
+  }
+  if (!any) {
+    return;
+  }
+  for (int i = GX_VA_POS; i <= GX_VA_TEX7; ++i) {
+    auto& array = g_gxState.arrays[i];
+    const auto desc = g_gxState.vtxDesc[i];
+    if (array.guestAvailable == 0 || (desc != GX_INDEX8 && desc != GX_INDEX16)) {
+      continue;
+    }
+    u32 maxIdx = 0;
+    for (u32 v = 0; v < vtxCount; ++v) {
+      const u8* p = vtx + v * vtxSize + offsets[i];
+      const u32 idx = desc == GX_INDEX8 ? p[0] : (static_cast<u32>(p[0]) << 8 | p[1]);
+      if (idx > maxIdx && (desc == GX_INDEX8 ? idx != 0xFF : idx != 0xFFFF)) {
+        maxIdx = idx;
+      }
+    }
+    const auto& attrFmt = vtxFmt.attrs[i];
+    const u32 elem = comp_type_size(static_cast<GXAttr>(i), attrFmt.type) *
+                     comp_cnt_count(static_cast<GXAttr>(i), attrFmt.cnt);
+    const u32 stride = array.stride != 0 ? array.stride : elem;
+    const u32 needed = std::min<u32>(AURORA_ALIGN(maxIdx * stride + std::max(elem, stride), 4u), array.guestAvailable);
+    if (needed > array.size) {
+      array.size = needed;
+      array.cachedRange = {};
+      g_gxState.dirty |= DirtyImmediates;
+    }
+  }
+}
