+/* The public FP / paired-single helpers forward to the *_exact versions through weak
+   definitions, so a host may replace them with strong ones that add fast paths (and call
+   the *_exact versions for everything else). */
+__attribute__((weak)) void ppc_fadds(CPUState* cpu, u8 d, u8 a, u8 b) { ppc_fadds_exact(cpu, d, a, b); }
+__attribute__((weak)) void ppc_fsubs(CPUState* cpu, u8 d, u8 a, u8 b) { ppc_fsubs_exact(cpu, d, a, b); }
+__attribute__((weak)) void ppc_fmuls(CPUState* cpu, u8 d, u8 a, u8 b) { ppc_fmuls_exact(cpu, d, a, b); }
+__attribute__((weak)) void ppc_fdivs(CPUState* cpu, u8 d, u8 a, u8 b) { ppc_fdivs_exact(cpu, d, a, b); }
+__attribute__((weak)) void ppc_fadd(CPUState* cpu, u8 d, u8 a, u8 b) { ppc_fadd_exact(cpu, d, a, b); }
+__attribute__((weak)) void ppc_fsub(CPUState* cpu, u8 d, u8 a, u8 b) { ppc_fsub_exact(cpu, d, a, b); }
+__attribute__((weak)) void ppc_fmul(CPUState* cpu, u8 d, u8 a, u8 b) { ppc_fmul_exact(cpu, d, a, b); }
+__attribute__((weak)) void ppc_fdiv(CPUState* cpu, u8 d, u8 a, u8 b) { ppc_fdiv_exact(cpu, d, a, b); }
+__attribute__((weak)) void ppc_ps_add_op(CPUState* cpu, u8 d, u8 a, u8 b) { ppc_ps_add_op_exact(cpu, d, a, b); }
+__attribute__((weak)) void ppc_ps_sub_op(CPUState* cpu, u8 d, u8 a, u8 b) { ppc_ps_sub_op_exact(cpu, d, a, b); }
+__attribute__((weak)) void ppc_ps_mul_op(CPUState* cpu, u8 d, u8 a, u8 b) { ppc_ps_mul_op_exact(cpu, d, a, b); }
+__attribute__((weak)) void ppc_ps_muls0(CPUState* cpu, u8 d, u8 a, u8 b) { ppc_ps_muls0_exact(cpu, d, a, b); }
+__attribute__((weak)) void ppc_ps_muls1(CPUState* cpu, u8 d, u8 a, u8 b) { ppc_ps_muls1_exact(cpu, d, a, b); }
+__attribute__((weak)) void ppc_ps_madds0(CPUState* cpu, u8 d, u8 a, u8 c, u8 b) { ppc_ps_madds0_exact(cpu, d, a, c, b); }
+__attribute__((weak)) void ppc_ps_madds1(CPUState* cpu, u8 d, u8 a, u8 c, u8 b) { ppc_ps_madds1_exact(cpu, d, a, c, b); }
+__attribute__((weak)) void ppc_ps_sum0(CPUState* cpu, u8 d, u8 a, u8 c, u8 b) { ppc_ps_sum0_exact(cpu, d, a, c, b); }
+__attribute__((weak)) void ppc_ps_sum1(CPUState* cpu, u8 d, u8 a, u8 c, u8 b) { ppc_ps_sum1_exact(cpu, d, a, c, b); }
+__attribute__((weak)) void ppc_frsp(CPUState* cpu, u8 d, u8 b) { ppc_frsp_exact(cpu, d, b); }
+__attribute__((weak)) void ppc_fcmp(CPUState* cpu, u8 crfd, f64 a, f64 b, bool ordered) { ppc_fcmp_exact(cpu, crfd, a, b, ordered); }
+__attribute__((weak)) bool ppc_fma(CPUState* cpu, f64 a, f64 c, f64 b, bool single, bool subtract, bool negative, f64* output) {
+    return ppc_fma_exact(cpu, a, c, b, single, subtract, negative, output);
+}
+__attribute__((weak)) void ppc_ps_madd_op(CPUState* cpu, u8 d, u8 a, u8 c, u8 b, bool subtract, bool negative) {
+    ppc_ps_madd_op_exact(cpu, d, a, c, b, subtract, negative);
+}
